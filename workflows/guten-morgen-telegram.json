      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "// Zufälligen Gruß auswählen und mit Wochentag + Datum ergänzen\nconst gruesse = [\n  'Guten Morgen! ☀️ Starte gut in den Tag.',\n  'Moin moin aus Bremen! ☕ Einen schönen Tag dir.',\n  'Guten Morgen! 🚀 Heute wird ein guter Tag.',\n  'Moin! 🌤️ Kaffee an, Laune hoch.',\n];\n\nconst jetzt = new Date();\nconst tag = jetzt.toLocaleDateString('de-DE', { weekday: 'long', day: '2-digit', month: 'long', timeZone: 'Europe/Berlin' });\nconst gruss = gruesse[Math.floor(Math.random() * gruesse.length)];\n\nreturn [{ json: { text: `${gruss}\\n\\nHeute ist ${tag}.` } }];"
      },
      "id": "a1f0c7e2-0001-4c1a-9a01-000000000002",
      "name": "Gruß zusammenbauen",
